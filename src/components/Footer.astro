---
import { personal, navigation } from '../data/personal';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <a class="brand footer-brand" href="#inicio"><span>{personal.initials}</span><i></i></a>
    <nav aria-label="Navegación del pie">{navigation.slice(1).map((item) => <a href={item.href}>{item.label}</a>)}</nav>
    <p>© {year} {personal.name}</p>
  </div>
</footer>
